#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT &kp LCTRL &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &kp LSHFT &kp LCTRL &kp LALT>;

            label = "HYPER";
        };
    };

    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // |       |  1  |  2   |   3   |   4   |   5   |                   |  6   |   7   |   8   |   9   |   0   |   `   |
            // |       |  Q  |  W   |   E   |   R   |   T   |                   |  Y   |   U   |   I   |   O   |   P   |   -   |
            // |  TAB  |  A  |S/LSH |D/LCTL | F/GUI |G/LALT |                   |H/RALT| J/GUI |K/RCTL |L/RSHFT|   ;   |   '   |
            // |       |  Z  |  X   |   C   |   V   |   B   |        |  |       |  N   |   M   |   ,   |   .   |   /   |   \   |
            //                      | HYPER | ESC   |LWR/SPC|        |  |       |RSE/ENT| BSPC | HYPER |

            bindings = <
&kp DELETE    &kp N1  &kp N2       &kp N3            &kp N4          &kp N5                          &kp N6           &kp N7           &kp N8             &kp N9       &kp N0         &kp GRAVE
&kp CAPSLOCK  &kp Q   &kp W        &kp E             &kp R           &kp T                           &kp Y            &kp U            &kp I              &kp O        &kp P          &kp MINUS
&kp COLON     &kp A   &hm LCTRL S  &hm LEFT_SHIFT D  &hm LEFT_GUI F  &hm LEFT_ALT G                  &hm RIGHT_ALT H  &hm RIGHT_GUI J  &hm RIGHT_SHIFT K  &hm RCTRL L  &kp SEMICOLON  &kp SQT
&hyper        &kp Z   &kp X        &kp C             &kp V           &kp B           &none    &none  &kp N            &kp M            &kp COMMA          &kp DOT      &kp FSLH       &kp BACKSLASH
                                   &kp TAB           &kp ESC         &lt 1 SPACE     &none    &none  &lt 2 ENTER      &kp BSPC         &hyper
            >;

            label = "BASE";
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // |  HOME |  F1 |  F2  |  F3   |  F4   |  F5   |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | PG_UP |     |      |   €   |       |       |                   |  ´   |   `   |  ^    |   ñ  |   =   |       |
            // | PG_DN |     |      |       |       |       |                   |  <-  |   ^   |   v   |  ->  |       |       |
            // |       |     |      |   ç   |       |       |                   |      |       |   [   |  ]   |       |       |
            //                      |       |       |       |                   |      |  DEL  |       |

            bindings = <
&kp HOME   &kp F1   &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6          &kp F7           &kp F8        &kp F9     &kp F10    &kp F11
&kp PG_UP  &kp F12  &trans  &trans  &trans  &trans                  &kp LA(E)       &kp LA(GRAVE)    &kp LA(I)     &kp LA(N)  &kp EQUAL  &trans
&kp PG_DN  &trans   &trans  &trans  &trans  &trans                  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW  &kp RIGHT  &kp PLUS   &kp LS(LA(NUMBER_2))
&kp END    &trans   &trans  &trans  &trans  &trans  &none    &none  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LBKT      &kp RBKT   &trans     &trans
                            &trans  &trans  &trans  &none    &none  &trans          &trans           &trans
            >;

            label = "LOWER";
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------------------------------
            // |BT_CLR | BT0 | BT1  | BT2   | BT3   | BT4   |                   |BT_DC0|BT_DC1 |BT_DC2 |BT_DC3|BT_DC4 | BOOT  |
            // |       |     |      |       |OUT_TOG| EP_TOG|                   | MUTE | VOL-  | VOL+  |      | LOCK  |       |
            // |       |     |      |       |       |       |                   | PLAY | PREV  | NEXT  |      |       |       |
            // |       |     |      |       |       |       |        |  |       |      | BRI-  | BRI+  |      |       |       |
            //                      |       |       |       |        |  |       |      |       |       |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0          &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bootloader
&trans             &trans                &trans         &trans        &trans        &trans                          &trans         &trans         &trans         &trans         &trans         &trans
&kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &trans         &trans        &trans        &trans                          &kp H          &kp J          &kp K          &kp L          &trans         &ext_power EP_TOG
&kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &kp LC(LG(Q))  &trans        &trans        &trans        &trans    &trans  &trans         &trans         &trans         &trans         &trans         &out OUT_TOG
                                                        &trans        &trans        &trans        &trans    &trans  &trans         &trans         &trans
            >;

            label = "RAISE";
        };
    };
};
